# Application
APP_NAME=Job Market Analytics Platform
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# Database
POSTGRES_USER=job_market_user
POSTGRES_PASSWORD=job_market_pass
POSTGRES_DB=job_market_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://job_market_user:job_market_pass@localhost:5432/job_market_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://job_market_user:job_market_pass@localhost:5432/airflow_db
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-change-in-production

# ETL
ETL_SCHEDULE_INTERVAL=0 */6 * * *
ETL_MAX_RETRIES=3
ETL_BATCH_SIZE=100

# Rate limiting per provider (seconds between requests)
RATE_LIMIT_DOU_UA=5.0
RATE_LIMIT_WORK_UA=3.0
RATE_LIMIT_ROBOTA_UA=3.0
RATE_LIMIT_DJINNI_CO=2.0
